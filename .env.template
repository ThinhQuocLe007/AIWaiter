# Hugging Face Access Token
HF_TOKEN=your_token_here

# System Configuration
DEVICE=cuda
# Device for the embedding model only. Leave empty to follow DEVICE.
# On Jetson set EMBEDDING_DEVICE=cpu to free iGPU/unified RAM for the Ollama LLM.
EMBEDDING_DEVICE=cuda


# THE system encoder — one shared model for retrieval AND intent routing. There is no
# second encoder at runtime: classifier_router_node encodes through encode_queries() and
# hands the vector to the MLP, so this single choice feeds both.
#
# It must stay 768-dim (bkai) as long as the shipped classifier checkpoint is the one
# trained in src/training_semantic_router — the MLP's first layer is 768+10 wide and a
# 1024-dim model like AITeamVN/Vietnamese_Embedding raises EmbeddingModelMismatch /
# a width error on the first utterance. Retrain before switching.
#
# Changing it also means rebuilding both artifacts:
#   python scripts/setup.py --embeddings-only     # vector index
#   python scripts/build_centroids.py             # semantic-router centroids
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder

# Encoder for the OFFLINE classifier scripts only (train / evaluate / benchmark / compare),
# which call classify() without a precomputed vector. Keep it equal to EMBEDDING_MODEL so
# training-time and serving-time vectors are produced the same way.
CLASSIFIER_EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
# └─ hết phần chết. EMBEDDING_MODEL/CLASSIFIER_EMBEDDING_MODEL cũng vậy: brain kho dùng EMBED_MODEL.

# Router SLM model (Ollama) — used by all workers / response
# ┌─ CHẾT: ba biến dưới đây thuộc bản NHÀ HÀNG (src/agent_brain/config/agent_config.py).
# │  Brain kho KHÔNG đọc chúng — nó đọc LLM_MODEL ở mục "BRAIN KHO" cuối file.
# │  Đổi ở đây không có tác dụng gì. Giữ lại vì agent_config vẫn khai báo.
ROUTER_MODEL=qwen2.5:14b-instruct-q6_K  
WORKER_MODEL=qwen2.5:14b-instruct-q6_K  
RESPONSE_MODEL=qwen2.5:14b-instruct-q6_K

# LangSmith Tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT=AI_Waiter_Dev

# Where the orchestrator (backend :8000) finds the LLM agent service (:8100). Only used to
# forward the tablet's "cuộc trò chuyện mới" reset; override when the agent runs on another host.
ORCH_AGENT_URL=http://127.0.0.1:8100

# ── Jetson tìm PC server ở đâu (đặt trên JETSON) ──────────────────────────────
# Hai địa chỉ của cùng một máy PC, qua VPN. Trên chính PC thì để 127.0.0.1.
#   ORCHESTRATOR_URL — backend :8000: hub WebSocket + web monitor + gương lượt nói
#   AGENT_URL        — brain :8100: nơi Jetson POST /chat/stream
ORCHESTRATOR_URL=http://127.0.0.1:8000
AGENT_URL=http://127.0.0.1:8100
VOICE_ROBOT_ID=robo-1

# ── Đường lệnh giọng nói → AGV kho (chỉ đặt trên JETSON) ──────────────────────
# IP LAN của LAPTOP chạy Gazebo + Nav2 + V-JEPA. Để trống thì Jetson chỉ nghe và trả lời, không
# điều khiển robot — đúng cho lúc test STT hoặc demo web monitor mà chưa mở sa bàn.
#
# Đây là chặng UDP: Jetson và laptop cùng một switch LAN ở nơi demo, và giá trị của một lệnh
# ("dừng lại") nằm trọn ở chỗ nó tới NGAY. Chặng đi PC server ở nhà (LLM) vẫn là HTTP qua VPN —
# xem ORCH_AGENT_URL ở trên — vì mất một lượt hội thoại là mất câu trả lời.
# Bên laptop chạy: make robotlink
ROBOT_UDP_HOST=
ROBOT_UDP_PORT=45455

# Bắn kèm lời giải của LLM hay chỉ bắn câu text thô?
#   1 (mặc định) — gói tin mang cả câu nói LẪN action đã hiểu. Laptop khỏi đoán; nếu VPN chết,
#                  action rỗng và laptop tự đọc câu bằng src/robot_link/parse_text.py.
#   0            — chỉ bắn câu text, laptop luôn tự đọc. Dùng để thử nhánh dự phòng cho chắc,
#                  hoặc nếu muốn laptop hoàn toàn không phụ thuộc con PC ở nhà.
ROBOT_LINK_SEND_ACTION=1

# ══ BRAIN KHO (src/agent_brain/warehouse/paths.py) ═══════════════════════════
# Đây mới là các biến brain kho THẬT SỰ đọc. Tên viết thường trong code, nhưng pydantic-settings
# không phân biệt hoa thường nên đặt HOA ở đây là đúng.
#
# Phải `ollama pull` đúng cái tên đặt ở đây, nếu không agent sẽ nhận 404 từ Ollama.
# LLM chỉ được gọi cho intent `chat` và cho planner (khi router không chắc) — hỏi vị trí, tồn kho,
# kiểm kê, điều hướng, dừng/đi tiếp đều trả lời tất định, không qua LLM. Nên 7b cũng chạy tốt nếu
# PC yếu; đổi thì nhớ pull đúng tên.
LLM_MODEL=qwen2.5:14b-instruct-q6_K
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama

# Embedding cho RAG và cho bộ phân loại ý định.
#
# CẢNH BÁO: `make train-router` và lúc chạy agent PHẢI dùng cùng một model. Trained weights là
# một MLP trên không gian vector của model này; đổi model sau khi train thì bộ phân loại vẫn chạy
# nhưng đoán bậy, không báo lỗi gì cả. Đổi model thì train lại.
# CPU cho đơn giản: model này nhỏ, chạy CPU vẫn nhanh, và để dành trọn VRAM cho con 14b của
# Ollama. PC có GPU rảnh thì đổi thành cuda, train-router sẽ nhanh hơn.
EMBED_MODEL=dangvantuan/vietnamese-embedding
EMBED_DEVICE=cpu
