.DS_Store
Thumbs.db

# Project-Specific: runtime artifacts
# Everything under storage/ is produced by running the system — conversation checkpoints, vector
# indexes, downloaded TTS voices, and the trained intent router. The whole directory is ignored
# rather than a list of patterns: the old list covered storage/db/*.db but not storage/*.db, so
# checkpoints.db landed one level up and got committed. `storage_path()` in
# agent_brain/warehouse/paths.py mkdir's it at startup, so nothing needs it to exist in git.
#
# storage/router/mlp_router.joblib especially must NOT be tracked. It is trained from
# router/intents.json, so a committed copy is a snapshot of whatever the label set was that day —
# clone it onto a new machine and the agent silently loads a router that never predicts the
# classes added since. Run `make train-router` on the machine that runs `make agent`.
storage/

# Anh Khôi's robot repo (github.com/AmightyK/workshop), unzipped in here by commit 4e191ca.
# Kept on disk, out of git: vendoring a repo somebody else is actively developing freezes it —
# their pushes never arrive and edits made here never reach them. Clone it separately, or add it
# as a submodule if one checkout really has to bring both.
workshop-main/
data/vector_db/
data/sqlite/
data/samples/
**/pretrained_models/

# Project-Specific: RTAB-Map map databases
# Hundreds of MB each, and the robot localizes on its own copy at ~/.ros/rtabmap.db anyway. What
# the repo DOES track is the small 2D grid exported from it (maps/restaurant.pgm + .yaml) — the
# floor the panel minimap draws. Re-export with `make map` after re-scanning the restaurant.
robot_ws/src/real/tarkbot_robot/maps/*.db

# Project-Specific: Audio Input Assets
# Audio files (.wav) are extremely large and should not be checked into Git
inputs/audio/**/*.wav
data/audio_sources/

# Evaluation Runs & Developer Scratchpad
# Keep test datasets (evals/data/) but ignore dynamic evaluation results
evals/results/
scratch/
!scratch/.gitkeep

# Logs and Jupyter
*.log
logs/
 .ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Dev scratchpad screenshots
pict/

# Documentation
*.docx
*.pdf

# Docs maintained in a separate repository
docs/
