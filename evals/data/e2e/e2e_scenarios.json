{
  "dataset": "e2e_scenarios",
  "version": "4.0",
  "description": "E2E evaluation for the single-intent MLP router + rewriter architecture. Covers 20 scenarios across 5 categories: happy-path, multi-intent rewriter path, modification & recovery, ambiguity & clarification, and long conversations. Every multi-intent turn exercises the rewriter → fragment classify → multi-worker pipeline. Dish names matched against menu.json (Ốc Quậy, 219 items).",
  "total_scenarios": 20,
  "categories": {
    "happy_path": 5,
    "multi_intent_rewriter": 5,
    "modification_recovery": 4,
    "ambiguity_clarification": 3,
    "long_conversation": 3
  },
  "scenarios": [
    {
      "id": "E2E-001",
      "category": "happy_path",
      "name": "single_item_order",
      "description": "Customer orders one dish clearly, confirms, completes. Tests basic sync_cart → confirm_order flow.",
      "table_id": "T_e2e_1",
      "difficulty": "easy",
      "expected_outcome": "order_placed",
      "turns": [
        {
          "turn": 1,
          "role": "user",
          "content": "Cho mình 2 phần Ốc Hương Xốt Trứng Muối",
          "assert": {
            "tool_called": "add_cart",
            "tool_output_contains": "Đã thêm",
            "response_should_contain_one_of": [
              "Ốc Hương",
              "tạm tính",
              "xác nhận",
              "đặt"
            ]
          }
        },
        {
          "turn": 2,
          "role": "user",
          "content": "Đúng rồi, xác nhận đặt luôn",
          "assert": {
            "tool_called": "confirm_order",
            "response_contains": "đơn hàng",
            "confirmed_items_must_contain": "Ốc Hương"
          }
        }
      ]
    },
    {
      "id": "E2E-002",
      "category": "happy_path",
      "name": "multi_item_order",
      "description": "Customer orders multiple items in one sentence, then confirms.",
      "table_id": "T_e2e_2",
      "difficulty": "easy",
      "expected_outcome": "order_placed",
      "turns": [
        {
          "turn": 1,
          "role": "user",
          "content": "Cho 3 con Hàu Nướng Phô Mai và 2 chai Bia Tiger nha",
          "assert": {
            "tool_called": "add_cart",
            "tool_output_contains": "Đã thêm",
            "response_should_contain_one_of": [
              "Hàu",
              "Bia",
              "tạm tính",
              "xác nhận"
            ]
          }
        },
        {
          "turn": 2,
          "role": "user",
          "content": "Ok chốt đơn đi em",
          "assert": {
            "tool_called": "confirm_order",
            "response_contains": "đơn hàng",
            "confirmed_items_must_contain": "Hàu"
          }
        }
      ]
    },
    {
      "id": "E2E-003",
