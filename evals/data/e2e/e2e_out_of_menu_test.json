{
  "dataset": "out_of_menu_e2e_test",
  "version": "4.2",
  "description": "Test từ chối món ngoài thực đơn cho menu quán ốc/hải sản 'Ốc Quậy'. Mở rộng từ 4 lên 30 scenario (v3.0 → v4.0): với n=4, khoảng tin cậy Wilson 95% của catch rate rộng hơn 50 điểm phần trăm nên con số đó không khẳng định được điều gì. Mỗi scenario mang một 'category' thuộc phân loại bên dưới, cho phép báo cáo catch rate theo từng loại lỗi thay vì một con số gộp che mất chỗ validator thực sự yếu. Bốn scenario gốc của v3.0 được giữ nguyên (OOM-001..004).",
  "categories": {
    "absent_item": "Món hoàn toàn không có, thuộc loại hình ẩm thực khác.",
    "near_miss": "Tên gần giống món có thật — kiểm tra nhánh gợi ý Jaccard >= 0.30 của validator.",
    "wrong_variant": "Món gốc có thật nhưng biến thể xốt/cách chế biến không tồn tại.",
    "mixed_valid_invalid": "Đơn trộn món hợp lệ và không hợp lệ — phải chặn đúng phần sai, giữ phần đúng.",
    "all_invalid": "Toàn bộ món trong đơn đều không tồn tại.",
    "hallucination_bait": "Câu được thiết kế để dụ LLM bịa món hoặc bịa giá.",
    "negative_control": "Toàn bộ món CÓ THẬT — dùng để đo false positive rate."
  },
  "scoring": {
    "catch": "Validator chặn được món không tồn tại VÀ agent không gọi confirm_order với món đó.",
    "false_positive": "Validator chặn nhầm một món CÓ THẬT — đo trên các scenario category=negative_control và trên trường valid_items.",
    "note": "Catch rate và false positive rate phải được báo cáo cùng nhau. Một validator chặn mọi thứ đạt catch rate 100% và hoàn toàn vô dụng; chỉ cặp số mới mô tả được hành vi thật. v4.1: các assertion chuyển từ kiểm tra CÂU CHỮ sang kiểm tra HÀNH VI. Bản v4.0 bắt buộc câu trả lời phải chứa cụm như 'không có', khiến 7/30 scenario trượt oan trong khi agent hành xử đúng (từ chối món sai, giỏ hàng rỗng, không gọi confirm_order) — nó chỉ diễn đạt bằng cách gợi ý món thay thế. Thuộc tính cần đo là 'không món nào khách không gọi lọt vào giỏ', nên dùng cart_must_NOT_contain và cart_only_declared_valid."
  },
  "menu_verified": "Mọi tên món trong invalid_items đã được đối chiếu với assets/data/menu.json và xác nhận KHÔNG tồn tại; mọi tên trong valid_items đã xác nhận tồn tại (kiểm tra ngày 2026-07-23).",
  "total_scenarios": 30,
